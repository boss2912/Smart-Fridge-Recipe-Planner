# ตัวอย่างการตั้งค่าสำหรับ nginx/compose.yaml
# คัดลอกไฟล์นี้เป็น nginx/.env (ไฟล์ .env อยู่ใน .gitignore จะไม่ถูก commit ขึ้น GitHub)

# --- แบบที่ 1: ทดสอบบนเครื่องเดียว (ค่าเริ่มต้น — ไม่ต้องสร้าง .env ก็ใช้ชุดนี้) ---
NGINX_BIND=127.0.0.1
NGINX_PORT=8080
BACKEND_UPSTREAM=host.docker.internal:5000

# --- แบบที่ 2: วันเดโม 2 เครื่อง (รันบนเครื่อง 1 ตาม ADR-009) ---
# NGINX_BIND=0.0.0.0
# NGINX_PORT=80
# BACKEND_UPSTREAM=192.168.1.20:5000
